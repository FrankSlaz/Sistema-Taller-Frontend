---
import { PUBLIC_APP_NAME } from 'astro:env/client';
import SidebarNav from '../../react/layout/SidebarNav';

interface NavItem {
  label: string;
  href: string;
  /** Solo visible para rol Administrador — ver SidebarNav.tsx. */
  adminOnly?: boolean;
}

interface NavGroup {
  title: string;
  items: NavItem[];
}

const groups: NavGroup[] = [
  {
    title: 'General',
    items: [{ label: 'Dashboard', href: '/dashboard' }],
  },
  {
    title: 'Taller',
    items: [
      { label: 'Órdenes de reparación', href: '/reparaciones' },
      { label: 'Diagnósticos', href: '/diagnosticos' },
      { label: 'Presupuestos', href: '/presupuestos' },
      { label: 'Garantías', href: '/garantias' },
      { label: 'Entregas', href: '/entregas' },
    ],
  },
  {
    title: 'Clientes y equipos',
    items: [
      { label: 'Clientes', href: '/clientes' },
      { label: 'Equipos', href: '/equipos' },
    ],
  },
  {
    title: 'Inventario',
    items: [
      { label: 'Productos', href: '/inventario' },
      { label: 'Movimientos', href: '/inventario/movimientos' },
      { label: 'Compras', href: '/compras', adminOnly: true },
      { label: 'Herramientas', href: '/herramientas', adminOnly: true },
      { label: 'Asignaciones', href: '/herramientas/asignaciones', adminOnly: true },
    ],
  },
  {
    title: 'Administración',
    items: [
      { label: 'Usuarios', href: '/usuarios', adminOnly: true },
      { label: 'Roles', href: '/roles', adminOnly: true },
      { label: 'Reportes', href: '/reportes', adminOnly: true },
      { label: 'Configuración', href: '/configuracion', adminOnly: true },
    ],
  },
];

const currentPath = Astro.url.pathname;
---

<aside
  class="fixed inset-y-0 left-0 z-30 hidden w-64 flex-col overflow-y-auto border-r border-graphite-700 bg-graphite-900 text-graphite-200 lg:flex"
>
  <div class="flex h-16 items-center gap-2 border-b border-graphite-700 px-5">
    <span class="h-2.5 w-2.5 rounded-full bg-amber-500"></span>
    <span class="font-display text-lg font-semibold tracking-tight text-white">
      {PUBLIC_APP_NAME}
    </span>
  </div>

  <SidebarNav client:load groups={groups} currentPath={currentPath} />
</aside>
