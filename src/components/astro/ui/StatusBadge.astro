---
interface Props {
  estado: string;
}

const { estado } = Astro.props;

const colorMap: Record<string, string> = {
  pendiente: 'bg-amber-50 text-amber-700 ring-amber-600/20',
  proceso: 'bg-blue-50 text-blue-700 ring-blue-600/20',
  'en proceso': 'bg-blue-50 text-blue-700 ring-blue-600/20',
  listo: 'bg-green-50 text-green-700 ring-green-600/20',
  entregado: 'bg-graphite-100 text-graphite-600 ring-graphite-500/20',
  cancelado: 'bg-red-50 text-red-700 ring-red-600/20',
};

const classes = colorMap[estado.toLowerCase()] ?? 'bg-graphite-100 text-graphite-600 ring-graphite-500/20';
---

<span
  class:list={[
    'inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium ring-1 ring-inset',
    classes,
  ]}
>
  {estado}
</span>
