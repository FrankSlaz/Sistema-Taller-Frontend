---
interface Props {
  title?: string;
  class?: string;
}

const { title, class: className } = Astro.props;
---

<div class:list={['rounded-lg border border-graphite-200 bg-white p-5 shadow-sm', className]}>
  {title && <h3 class="mb-4 font-display text-base font-semibold text-graphite-900">{title}</h3>}
  <slot />
</div>
