---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import Card from '../../components/astro/cards/Card.astro';
import PagosGlobalPanel from '../../components/react/modules/pagos/PagosGlobalPanel';
---

<DashboardLayout title="Caja y pagos">
  <div class="mb-6">
    <h1 class="font-display text-2xl font-semibold text-graphite-900">Caja y pagos</h1>
    <p class="text-sm text-graphite-400">
      Movimientos de caja con su resumen para cuadrar el día. Un pago no se borra: se anula con motivo.
    </p>
  </div>

  <Card>
    <PagosGlobalPanel client:only="react" />
  </Card>
</DashboardLayout>
