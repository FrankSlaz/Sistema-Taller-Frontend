---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import Card from '../../components/astro/cards/Card.astro';
import AuditoriaPanel from '../../components/react/modules/auditoria/AuditoriaPanel';
---

<DashboardLayout title="Auditoría">
  <div class="mb-6">
    <h1 class="font-display text-2xl font-semibold text-graphite-900">Auditoría</h1>
    <p class="text-sm text-graphite-400">
      Quién hizo qué y cuándo: cada cambio del sistema con el detalle de los campos (antes y después). Solo lectura,
      solo para el rol Administrador.
    </p>
  </div>

  <Card>
    <AuditoriaPanel client:load />
  </Card>
</DashboardLayout>
