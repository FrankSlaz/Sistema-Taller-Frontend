---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import Card from '../../components/astro/cards/Card.astro';
import GarantiasPanel from '../../components/react/modules/garantias/GarantiasPanel';
---

<DashboardLayout title="Garantías">
  <div class="mb-6">
    <h1 class="font-display text-2xl font-semibold text-graphite-900">Garantías</h1>
    <p class="text-sm text-graphite-400">
      Garantías otorgadas sobre órdenes ya entregadas. Solo se puede generar una garantía por orden.
    </p>
  </div>

  <Card>
    <GarantiasPanel client:load />
  </Card>
</DashboardLayout>
