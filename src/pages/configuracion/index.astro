---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import Card from '../../components/astro/cards/Card.astro';
import ConfiguracionPanel from '../../components/react/modules/configuracion/ConfiguracionPanel';
import LogoSection from '../../components/react/modules/configuracion/LogoSection';
---

<DashboardLayout title="Configuración">
  <div class="mb-6">
    <h1 class="font-display text-2xl font-semibold text-graphite-900">Configuración</h1>
    <p class="text-sm text-graphite-400">Datos generales del taller, usados en documentos y reportes.</p>
  </div>

  <!-- Datos generales a la izquierda; logo en su propia tarjeta a la derecha.
       En pantallas chicas se apilan (logo arriba, para que se vea primero). -->
  <div class="grid grid-cols-1 items-start gap-6 lg:grid-cols-3">
    <Card title="Datos del taller" class="order-2 lg:order-1 lg:col-span-2">
      <ConfiguracionPanel client:load />
    </Card>

    <Card title="Logo de la empresa" class="order-1 lg:order-2 lg:sticky lg:top-24">
      <LogoSection client:load />
    </Card>
  </div>
</DashboardLayout>
