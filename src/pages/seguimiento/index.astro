---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import Card from '../../components/astro/cards/Card.astro';
import SeguimientoPanel from '../../components/react/modules/seguimiento/SeguimientoPanel';
---

<DashboardLayout title="Seguimiento">
  <div class="mb-6">
    <h1 class="font-display text-2xl font-semibold text-graphite-900">Seguimiento</h1>
    <p class="text-sm text-graphite-400">
      Supervisá el avance de todas las órdenes por estado. Si sos técnico, solo vas a ver tus órdenes asignadas.
    </p>
  </div>

  <Card>
    <SeguimientoPanel client:load />
  </Card>
</DashboardLayout>
