---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import Card from '../../components/astro/cards/Card.astro';
import UsuariosPanel from '../../components/react/modules/usuarios/UsuariosPanel';
---

<DashboardLayout title="Usuarios">
  <div class="mb-6">
    <h1 class="font-display text-2xl font-semibold text-graphite-900">Usuarios</h1>
    <p class="text-sm text-graphite-400">
      Cuentas del personal del taller. Solo accesible con rol Administrador.
    </p>
  </div>

  <Card>
    <UsuariosPanel client:load />
  </Card>
</DashboardLayout>
