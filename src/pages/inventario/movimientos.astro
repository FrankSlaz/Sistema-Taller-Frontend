---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import Card from '../../components/astro/cards/Card.astro';
import MovimientosPanel from '../../components/react/modules/inventario/MovimientosPanel';

const productoIdParam = Astro.url.searchParams.get('productoId');
const productoId = productoIdParam ? Number(productoIdParam) : undefined;
const productoNombre = Astro.url.searchParams.get('productoNombre') ?? undefined;
---

<DashboardLayout title="Movimientos de inventario">
  <div class="mb-6">
    <h1 class="font-display text-2xl font-semibold text-graphite-900">Movimientos de inventario</h1>
    <p class="text-sm text-graphite-400">Historial de entradas, salidas y ajustes de stock.</p>
  </div>

  <Card>
    <MovimientosPanel client:load productoId={productoId} productoNombre={productoNombre} />
  </Card>
</DashboardLayout>
