---
/**
 * Página PÚBLICA de seguimiento para clientes (sin sesión): /s/<token>.
 * Se renderiza en el servidor (rápida en el celular, funciona sin
 * JavaScript y WhatsApp puede mostrar la vista previa del enlace). Es solo
 * de consulta: no tiene ninguna acción que modifique datos.
 */
import { PUBLIC_API_URL } from 'astro:env/client';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Brand from '../../components/astro/ui/Brand.astro';
import { estadoOrdenClasses } from '../../lib/utils/estado';

interface Etapa {
  estado: string;
  etiqueta: string;
  descripcion: string;
  fecha: string | null;
  completada: boolean;
  actual: boolean;
}
interface Seguimiento {
  taller: { nombre: string; telefono: string | null; whatsapp: string | null; direccion: string | null; email: string | null };
  orden: {
    codigo: string;
    estado: string;
    estadoEtiqueta: string;
    finalizada: boolean;
    fechaIngreso: string | null;
    fechaCompromiso: string | null;
    fechaEntrega: string | null;
    fallaReportada: string | null;
    ultimaActualizacion: string | null;
  };
  cliente: { nombre: string };
  equipo: { tipo: string; marca: string | null; modelo: string | null; color: string | null };
  etapas: Etapa[];
  diagnosticos: {
    fecha: string | null;
    tecnico: string | null;
    fallaDetectada: string | null;
    diagnostico: string | null;
    solucionPropuesta: string | null;
    observaciones: string | null;
  }[];
  trabajos: { fecha: string | null; descripcion: string | null; monto: number }[];
  repuestos: { nombre: string; cantidad: number }[];
  montos: { total: number; pagado: number; saldo: number } | null;
  presupuestoPendiente: { total: number } | null;
  garantia: { estado: string | null; dias: number | null; fechaFin: string | null } | null;
}

const { token = '' } = Astro.params;
let datos: Seguimiento | null = null;
let error: string | null = null;

// IP del visitante: el backend limita los intentos con enlaces inválidos
// por cliente (sin esto, todas las visitas parecerían venir de este servidor).
let ipCliente = '';
try {
  ipCliente = Astro.clientAddress;
} catch {
  // el adaptador no la expone: el backend usa la del servidor
}

try {
  const res = await fetch(`${PUBLIC_API_URL}/publico/seguimiento/${encodeURIComponent(token)}`, {
    signal: AbortSignal.timeout(5000),
    headers: ipCliente ? { 'X-Forwarded-For': ipCliente } : undefined,
  });
  if (res.ok) {
    datos = ((await res.json()) as { data: Seguimiento }).data;
  } else {
    error =
      res.status === 404
        ? 'Este enlace de seguimiento no es válido o fue reemplazado. Solicita uno nuevo al taller.'
        : res.status === 429
          ? 'Se intentaron demasiados enlaces no válidos desde tu conexión. Espera unos minutos e intenta de nuevo.'
          : 'No pudimos cargar la información en este momento. Intenta de nuevo en unos minutos.';
    Astro.response.status = res.status === 404 ? 404 : res.status === 429 ? 429 : 503;
  }
} catch {
  error = 'No pudimos conectarnos con el taller. Revisa tu conexión e intenta de nuevo.';
  Astro.response.status = 503;
}
// Datos personales: que ningún navegador/proxy compartido los guarde.
Astro.response.headers.set('Cache-Control', 'no-store');

const ZONA = 'America/La_Paz';
const fecha = (iso: string | null, conHora = false) =>
  iso
    ? new Date(iso).toLocaleString('es-BO', {
        timeZone: ZONA,
        day: 'numeric',
        month: 'long',
        year: 'numeric',
        ...(conHora && { hour: '2-digit', minute: '2-digit' }),
      })
    : null;
const fechaCorta = (iso: string | null) =>
  iso ? new Date(iso).toLocaleDateString('es-BO', { timeZone: ZONA, day: '2-digit', month: 'short' }) : null;
const bs = (n: number) => `Bs ${n.toLocaleString('es-BO', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;

const d = datos;
const equipoTexto = d ? [d.equipo.tipo, d.equipo.marca, d.equipo.modelo].filter(Boolean).join(' ') : '';
const etapasFlujo = d ? d.etapas.filter((e) => !['CANCELADO', 'NO_REPARABLE'].includes(e.estado)) : [];
const avance = d
  ? d.orden.estado === 'ENTREGADO'
    ? 100
    : Math.round(
        ((etapasFlujo.findIndex((e) => e.actual) + 1 || etapasFlujo.filter((e) => e.completada).length) /
          Math.max(1, etapasFlujo.length)) *
          100,
      )
  : 0;
const cerrada = d ? ['CANCELADO', 'NO_REPARABLE'].includes(d.orden.estado) : false;

const mensajeTaller = d
  ? encodeURIComponent(`Hola, consulto por mi orden ${d.orden.codigo} (${equipoTexto}).`)
  : '';
const linkWhatsapp = d?.taller.whatsapp ? `https://wa.me/${d.taller.whatsapp}?text=${mensajeTaller}` : null;
const linkTelefono = d?.taller.telefono ? `tel:${d.taller.telefono.replace(/[^\d+]/g, '')}` : null;

// Respuesta al presupuesto por WhatsApp (la página sigue siendo solo de
// consulta: el personal registra la aprobación en el sistema).
const respuesta = (texto: string) =>
  d?.taller.whatsapp ? `https://wa.me/${d.taller.whatsapp}?text=${encodeURIComponent(texto)}` : null;
const montoPendiente = d?.presupuestoPendiente ? bs(d.presupuestoPendiente.total) : '';
const linkAprobar = d?.presupuestoPendiente
  ? respuesta(`Hola, APRUEBO el presupuesto de ${montoPendiente} de la orden ${d.orden.codigo} (${equipoTexto}). Pueden continuar con la reparación.`)
  : null;
const linkRechazar = d?.presupuestoPendiente
  ? respuesta(`Hola, NO apruebo el presupuesto de ${montoPendiente} de la orden ${d.orden.codigo} (${equipoTexto}).`)
  : null;
---

<BaseLayout
  title={d ? `Orden ${d.orden.codigo}` : 'Seguimiento de reparación'}
  description="Consulta el estado de tu reparación"
  noindex
  og={{
    title: d ? `Seguimiento de tu reparación · ${d.orden.codigo}` : 'Seguimiento de reparación',
    description: d
      ? `${equipoTexto} — Estado actual: ${d.orden.estadoEtiqueta}.`
      : 'Consulta el estado y avance de la reparación de tu equipo.',
  }}
>
  <!-- Responsivo: una columna en celular; dos columnas desde pantallas grandes -->
  <div class="mx-auto min-h-screen max-w-lg px-4 pb-10 pt-5 sm:px-6 lg:max-w-6xl lg:pt-8">
    <header class="mb-5 flex items-center justify-between gap-3">
      <Brand />
      <span class="shrink-0 rounded-full bg-graphite-100 px-2.5 py-1 text-[11px] font-medium text-graphite-500">
        Seguimiento
      </span>
    </header>

    {
      error && (
        <div class="rounded-2xl border border-graphite-200 bg-white p-6 text-center shadow-sm">
          <div class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-full bg-amber-50 text-2xl" aria-hidden="true">
            🔍
          </div>
          <h1 class="font-display text-lg font-semibold">No encontramos tu orden</h1>
          <p class="mt-2 text-sm text-graphite-500">{error}</p>
        </div>
      )
    }

    {
      d && (
        <main class="space-y-4 lg:grid lg:grid-cols-5 lg:items-start lg:gap-6 lg:space-y-0">
          <div class="space-y-4 lg:col-span-3">
          {/* Estado actual */}
          <section class="rounded-2xl border border-graphite-200 bg-white p-5 shadow-sm">
            <p class="text-sm text-graphite-500">Hola, {d.cliente.nombre} 👋</p>
            <div class="mt-1 flex flex-wrap items-center justify-between gap-2">
              <h1 class="font-display text-xl font-semibold tracking-tight">{d.orden.codigo}</h1>
              <span class={`inline-flex items-center rounded-full px-3 py-1 text-sm font-semibold ring-1 ring-inset ${estadoOrdenClasses(d.orden.estado)}`}>
                {d.orden.estadoEtiqueta}
              </span>
            </div>
            <p class="mt-1 text-sm text-graphite-600">{equipoTexto}</p>

            {
              !cerrada && (
                <div class="mt-4">
                  <div class="mb-1.5 flex justify-between text-xs text-graphite-500">
                    <span>Avance</span>
                    <span class="font-medium text-graphite-700">{avance}%</span>
                  </div>
                  <div class="h-2.5 overflow-hidden rounded-full bg-graphite-100" role="progressbar" aria-valuenow={avance} aria-valuemin="0" aria-valuemax="100" aria-label="Avance de la reparación">
                    <div class="h-full rounded-full bg-amber-500" style={`width:${Math.max(4, avance)}%`} />
                  </div>
                </div>
              )
            }

            {
              d.orden.ultimaActualizacion && (
                <p class="mt-3 text-xs text-graphite-400">Última actualización: {fecha(d.orden.ultimaActualizacion, true)}</p>
              )
            }
          </section>

          {/* Avisos destacados */}
          {
            d.orden.estado === 'LISTO_ENTREGA' && (
              <section class="rounded-2xl border border-green-200 bg-green-50 p-4 text-green-900">
                <p class="font-semibold">¡Tu equipo está listo! 🎉</p>
                <p class="mt-1 text-sm">
                  Puedes pasar a retirarlo{d.montos && d.montos.saldo > 0 ? <> · saldo a pagar: <strong>{bs(d.montos.saldo)}</strong></> : '.'}
                </p>
              </section>
            )
          }
          {
            d.presupuestoPendiente && (
              <section class="rounded-2xl border border-amber-200 bg-amber-50 p-4 text-amber-900">
                <p class="font-semibold">Tienes un presupuesto por aprobar</p>
                <p class="mt-1 text-sm">
                  Monto: <strong>{bs(d.presupuestoPendiente.total)}</strong>.
                  {linkAprobar ? ' Responde al taller para continuar con la reparación:' : ' Comunícate con el taller para aprobarlo y continuar con la reparación.'}
                </p>
                {
                  linkAprobar && linkRechazar && (
                    <div class="mt-3 grid grid-cols-2 gap-2">
                      <a
                        href={linkAprobar}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="flex items-center justify-center rounded-xl bg-[#1fa855] px-3 py-2.5 text-sm font-semibold text-white hover:bg-[#1a9049]"
                      >
                        ✓ Aprobar
                      </a>
                      <a
                        href={linkRechazar}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="flex items-center justify-center rounded-xl border border-amber-300 bg-white px-3 py-2.5 text-sm font-semibold text-amber-900 hover:bg-amber-100"
                      >
                        Rechazar
                      </a>
                    </div>
                  )
                }
                {linkAprobar && (
                  <p class="mt-2 text-xs text-amber-800/80">Se abrirá WhatsApp con tu respuesta lista para enviar al taller.</p>
                )}
              </section>
            )
          }

          {/* Línea de tiempo */}
          <section class="rounded-2xl border border-graphite-200 bg-white p-5 shadow-sm">
            <h2 class="mb-4 font-display text-base font-semibold">Etapas de la reparación</h2>
            <ol class="relative">
              {
                d.etapas.map((e, i) => {
                  const ultimo = i === d.etapas.length - 1;
                  const cierre = ['CANCELADO', 'NO_REPARABLE'].includes(e.estado);
                  const punto = cierre
                    ? 'bg-red-500 text-white'
                    : e.completada
                      ? 'bg-graphite-900 text-white'
                      : e.actual
                        ? 'bg-amber-500 text-white ring-4 ring-amber-100'
                        : 'border-2 border-graphite-200 bg-white text-graphite-300';
                  return (
                    <li class="relative flex gap-3 pb-5 last:pb-0">
                      {!ultimo && (
                        <span
                          class={`absolute left-[13px] top-7 h-[calc(100%-1.5rem)] w-0.5 ${e.completada ? 'bg-graphite-900' : 'bg-graphite-200'}`}
                          aria-hidden="true"
                        />
                      )}
                      <span class={`relative z-10 flex h-7 w-7 shrink-0 items-center justify-center rounded-full text-xs font-bold ${punto}`} aria-hidden="true">
                        {cierre ? '✕' : e.completada ? '✓' : e.actual ? '●' : ''}
                      </span>
                      <div class="min-w-0 pt-0.5">
                        <p class={`text-sm ${e.actual ? 'font-semibold text-graphite-900' : e.completada ? 'font-medium text-graphite-800' : 'text-graphite-400'}`}>
                          {e.etiqueta}
                          {e.actual && !cierre && <span class="ml-1.5 rounded bg-amber-100 px-1.5 py-0.5 text-[10px] font-semibold uppercase text-amber-800">Ahora</span>}
                          <span class="sr-only">{e.completada ? '(completada)' : e.actual ? '(etapa actual)' : '(pendiente)'}</span>
                        </p>
                        {e.fecha && <p class="text-xs text-graphite-400">{fechaCorta(e.fecha)}</p>}
                        {e.actual && <p class="mt-1 text-sm text-graphite-600">{e.descripcion}</p>}
                      </div>
                    </li>
                  );
                })
              }
            </ol>
          </section>

          {/* Trabajo realizado: diagnósticos (igual que el panel del taller),
              trabajos aprobados y repuestos utilizados */}
          {
            (d.diagnosticos.length > 0 || d.trabajos.length > 0 || d.repuestos.length > 0) && (
              <section class="rounded-2xl border border-graphite-200 bg-white p-5 shadow-sm">
                <h2 class="mb-4 font-display text-base font-semibold">Trabajo realizado en tu equipo</h2>

                {d.diagnosticos.length > 0 && (
                  <div class="space-y-4">
                    {d.diagnosticos.map((dg) => (
                      <article class="rounded-xl border border-graphite-100 bg-graphite-50/60 p-4">
                        <p class="mb-3 flex flex-wrap items-center gap-x-2 text-xs text-graphite-500">
                          <span class="font-semibold uppercase tracking-wide text-amber-700">Diagnóstico técnico</span>
                          {dg.fecha && <span>· {fecha(dg.fecha)}</span>}
                          {dg.tecnico && <span>· Técnico: {dg.tecnico}</span>}
                        </p>
                        <dl class="grid gap-3 sm:grid-cols-2">
                          {[
                            ['Falla detectada', dg.fallaDetectada],
                            ['Diagnóstico', dg.diagnostico],
                            ['Solución propuesta', dg.solucionPropuesta],
                            ['Observaciones', dg.observaciones],
                          ]
                            .filter(([, v]) => v)
                            .map(([etiqueta, v]) => (
                              <div>
                                <dt class="text-xs font-semibold uppercase tracking-wide text-graphite-400">{etiqueta}</dt>
                                <dd class="mt-0.5 whitespace-pre-line text-sm text-graphite-800">{v}</dd>
                              </div>
                            ))}
                        </dl>
                      </article>
                    ))}
                  </div>
                )}

                {d.trabajos.length > 0 && (
                  <div class="mt-5">
                    <h3 class="mb-2 text-xs font-semibold uppercase tracking-wide text-graphite-400">Trabajos aprobados</h3>
                    <ul class="divide-y divide-graphite-100 rounded-xl border border-graphite-100">
                      {d.trabajos.map((t) => (
                        <li class="flex items-start justify-between gap-3 px-4 py-2.5 text-sm">
                          <span class="text-graphite-800">
                            {t.descripcion ?? 'Reparación aprobada'}
                            {t.fecha && <span class="block text-xs text-graphite-400">{fecha(t.fecha)}</span>}
                          </span>
                          <span class="shrink-0 font-medium tabular-nums text-graphite-900">{bs(t.monto)}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}

                {d.repuestos.length > 0 && (
                  <div class="mt-5">
                    <h3 class="mb-2 text-xs font-semibold uppercase tracking-wide text-graphite-400">Repuestos utilizados</h3>
                    <ul class="flex flex-wrap gap-2">
                      {d.repuestos.map((r) => (
                        <li class="rounded-full border border-graphite-200 bg-white px-3 py-1 text-sm text-graphite-700">
                          {r.nombre}
                          {r.cantidad > 1 && <span class="ml-1 font-semibold">× {r.cantidad}</span>}
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </section>
            )
          }
          </div>

          <div class="space-y-4 lg:sticky lg:top-6 lg:col-span-2">

          {/* Montos */}
          {
            d.montos && (
              <section class="rounded-2xl border border-graphite-200 bg-white p-5 shadow-sm">
                <h2 class="mb-3 font-display text-base font-semibold">Costo de la reparación</h2>
                <dl class="space-y-2 text-sm">
                  <div class="flex justify-between">
                    <dt class="text-graphite-500">Total aprobado</dt>
                    <dd class="font-medium tabular-nums">{bs(d.montos.total)}</dd>
                  </div>
                  <div class="flex justify-between">
                    <dt class="text-graphite-500">Pagado</dt>
                    <dd class="font-medium tabular-nums text-green-700">{bs(d.montos.pagado)}</dd>
                  </div>
                  <div class="flex justify-between border-t border-graphite-100 pt-2">
                    <dt class="font-semibold">Saldo pendiente</dt>
                    <dd class={`font-display text-lg font-semibold tabular-nums ${d.montos.saldo > 0 ? 'text-amber-700' : 'text-green-700'}`}>
                      {d.montos.saldo > 0 ? bs(d.montos.saldo) : 'Pagado ✓'}
                    </dd>
                  </div>
                </dl>
              </section>
            )
          }

          {/* Garantía */}
          {
            d.garantia && (
              <section class="rounded-2xl border border-graphite-200 bg-white p-5 shadow-sm">
                <h2 class="mb-1 font-display text-base font-semibold">Garantía</h2>
                <p class="text-sm text-graphite-600">
                  {d.garantia.dias ? `${d.garantia.dias} días` : 'Garantía'}
                  {d.garantia.fechaFin && <> · válida hasta el <strong>{fecha(d.garantia.fechaFin)}</strong></>}
                </p>
              </section>
            )
          }

          {/* Datos de la orden */}
          <section class="rounded-2xl border border-graphite-200 bg-white p-5 shadow-sm">
            <h2 class="mb-3 font-display text-base font-semibold">Datos de la orden</h2>
            <dl class="space-y-3 text-sm">
              <div>
                <dt class="text-xs text-graphite-400">Equipo</dt>
                <dd class="text-graphite-800">{equipoTexto}{d.equipo.color && ` · ${d.equipo.color}`}</dd>
              </div>
              <div>
                <dt class="text-xs text-graphite-400">Fecha de recepción</dt>
                <dd class="text-graphite-800">{fecha(d.orden.fechaIngreso) ?? '—'}</dd>
              </div>
              {
                d.orden.fechaCompromiso && !d.orden.finalizada && (
                  <div>
                    <dt class="text-xs text-graphite-400">Entrega estimada</dt>
                    <dd class="text-graphite-800">{fecha(d.orden.fechaCompromiso)}</dd>
                  </div>
                )
              }
              {
                d.orden.fechaEntrega && (
                  <div>
                    <dt class="text-xs text-graphite-400">Fecha de entrega</dt>
                    <dd class="text-graphite-800">{fecha(d.orden.fechaEntrega)}</dd>
                  </div>
                )
              }
              {
                d.orden.fallaReportada && (
                  <div>
                    <dt class="text-xs text-graphite-400">Falla reportada</dt>
                    <dd class="text-graphite-800">{d.orden.fallaReportada}</dd>
                  </div>
                )
              }
            </dl>
          </section>

          {/* Contacto */}
          {
            (linkWhatsapp || linkTelefono || d.taller.direccion) && (
              <section class="rounded-2xl border border-graphite-200 bg-white p-5 shadow-sm">
                <h2 class="mb-3 font-display text-base font-semibold">¿Tienes dudas?</h2>
                <div class="space-y-2">
                  {linkWhatsapp && (
                    <a
                      href={linkWhatsapp}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="flex w-full items-center justify-center gap-2 rounded-xl bg-[#1fa855] px-4 py-3 text-sm font-semibold text-white hover:bg-[#1a9049]"
                    >
                      <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.6-1.3a.4.4 0 0 0 0-.4l-.8-1.9c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.9 11.9 0 0 0 4.6 4c1.7.7 2.3.8 3.2.7a2.7 2.7 0 0 0 1.8-1.3 2.2 2.2 0 0 0 .1-1.3c0-.1-.2-.2-.5-.3Z"/></svg>
                      Escribir por WhatsApp
                    </a>
                  )}
                  {linkTelefono && (
                    <a
                      href={linkTelefono}
                      class="flex w-full items-center justify-center gap-2 rounded-xl border border-graphite-200 px-4 py-3 text-sm font-semibold text-graphite-800 hover:bg-graphite-50"
                    >
                      📞 Llamar al {d.taller.telefono}
                    </a>
                  )}
                  {d.taller.direccion && <p class="pt-1 text-center text-xs text-graphite-500">📍 {d.taller.direccion}</p>}
                </div>
              </section>
            )
          }

            <p class="px-2 text-center text-xs text-graphite-400">
              Este enlace es personal: no lo compartas. La información es solo de consulta.
            </p>
          </div>
        </main>
      )
    }
  </div>
</BaseLayout>
